{
  "drone": "{{ name|json_escape }}",
  "uas_id": "{{ uas_id|json_escape }}",
  "session": "{{ session_id[:8]|json_escape }}",
  "altitude_m": {{ altitude if altitude is not none else 'null' }},
  "height": {{ height if height is not none else 'null' }},
  "height_type": "{{ height_type if height_type else ''|json_escape }}",
  "collector_distance_m": {% if collector_distance %}{{ collector_distance }}{% else %}null{% endif %},
  "collector_name": {% if collector_name %}"{{ collector_name|json_escape }}"{% else %}null{% endif %},
  "collector_bearing_deg": {% if collector_bearing %}{{ collector_bearing }}{% else %}null{% endif %},
  "timestamp": "{{ timestamp }}"
}