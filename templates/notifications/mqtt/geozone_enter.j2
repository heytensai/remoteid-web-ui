{
  "event": "geozone_enter",
  "timestamp": "{{ timestamp }}",
  "uas_id": "{{ uas_id|json_escape }}",
  "name": "{{ name|json_escape }}",
  "geozone": "{{ geozone_name|json_escape }}"
{% if altitude is defined and altitude is not none %},
  "altitude": {{ '%.2f' % altitude }}
{% endif %}
{% if height is defined and height is not none %},
  "height": {{ '%.2f' % height }}
{% endif %}
{% if height_type is defined and height_type is not none %},
  "height_type": "{{ height_type|json_escape }}"
{% endif %}
{% if lat is defined and lat is not none %},
  "latitude": {{ '%.6f' % lat }}
{% endif %}
{% if lon is defined and lon is not none %},
  "longitude": {{ '%.6f' % lon }}
{% endif %}
{% if flight_url or server_url %},
  "flight_url": "{{ (flight_url or server_url)|json_escape }}"
{% endif %}{% if server_url %},
  "server_url": "{{ server_url|json_escape }}"
{% endif %}
}