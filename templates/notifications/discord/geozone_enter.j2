{
  "embeds": [{
    "title": "Geozone Alert",
    "color": 15158332,
    "description": "{{ name|json_escape }} entered {{ geozone_name|json_escape }}{% set _alt = format_altitude(altitude, height, height_type, use_metric) %}{% if _alt %} at {{ _alt }}{% endif %}",
    "fields": [
      {"name": "Drone", "value": "{{ name|json_escape }}", "inline": true},
      {"name": "Zone", "value": "{{ geozone_name|json_escape }}", "inline": true}
      {% if altitude is defined and altitude is not none -%}
      ,{"name": "Altitude", "value": "{{ '%.0f' % (altitude if use_metric else altitude * 3.28084) }}{{ 'm' if use_metric else 'ft' }}", "inline": true}
      {% endif -%}
      {% if height is defined and height is not none -%}
      ,{"name": "Height{% if height_type %} ({{ height_type|json_escape }}){% endif %}", "value": "{{ '%.0f' % (height if use_metric else height * 3.28084) }}{{ 'm' if use_metric else 'ft' }}", "inline": true}
      {% endif -%}
    ],
    "timestamp": "{{ timestamp }}"{% if flight_url or server_url %},
    "url": "{{ flight_url or server_url }}"{% endif %}
  }]
}