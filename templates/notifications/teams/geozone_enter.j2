{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "contentUrl": null,
      "content": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.2",
        "body": [
          {
            "type": "TextBlock",
            "text": "**Geozone Alert**",
            "weight": "Bolder",
            "size": "Large"
          },
          {
            "type": "TextBlock",
            "text": "Drone **{{ name|json_escape }}** entered **{{ geozone_name|json_escape }}**{% set _alt = format_altitude(altitude, height, height_type, use_metric) %}{% if _alt %} at **{{ _alt }}**{% endif %}"
          },
          {
            "type": "FactSet",
            "facts": [
              {"title": "Drone", "value": "{{ name|json_escape }}"},
              {"title": "Zone", "value": "{{ geozone_name|json_escape }}"}
              {% if altitude is defined and altitude is not none -%}
              ,{"title": "Altitude", "value": "{{ '%.0f' % (altitude if use_metric else altitude * 3.28084) }}{{ 'm' if use_metric else 'ft' }}"}
              {% endif -%}
              {% if height is defined and height is not none -%}
              ,{"title": "Height{% if height_type %} ({{ height_type|json_escape }}){% endif %}", "value": "{{ '%.0f' % (height if use_metric else height * 3.28084) }}{{ 'm' if use_metric else 'ft' }}"}
              {% endif -%}
            ]
          }{% if flight_url or server_url %},
          {
            "type": "TextBlock",
            "text": "[Open in Remote ID]({{ flight_url or server_url }})",
            "isSubtle": true,
            "size": "Small"
          }{% endif %}
        ]
      }
    }
  ]
}